    "# Get importances and sorted indices\n",
    "feature_importances = rf_classifier.feature_importances_\n",
    "indices = np.argsort(feature_importances)[::-1]\n",
    "\n",
    "# Create a figure\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.title(\"Feature Importances\")\n",
    "\n",
    "# Plot a horizontal bar chart using barh()\n",
    "# The 'width' is the feature importances, and the 'y' values are the indices.\n",
    "plt.barh(y=range(X_label.shape[1]), \n",
    "         width=feature_importances[indices],\n",
    "         align=\"center\")\n",
    "\n",
    "# Label the y-axis with feature names\n",
    "plt.yticks(range(X_label.shape[1]), [numeric_columns[i] for i in indices])\n",
